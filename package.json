{
  "name": "durisense",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "typecheck": "npm --workspace frontend run typecheck",
    "backend:up": "docker compose up -d --build db api",
    "backend:logs": "docker compose logs -f api",
    "test:backend": "docker compose --profile test run --rm --build api-test"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
